# PostgreSQL development credentials
POSTGRES_DB=marketflow
POSTGRES_USER=marketflow
POSTGRES_PASSWORD=marketflow_dev

# Host-side database connection. Compose uses db:5432 inside its network.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Local API port and JWT lifetime
DJANGO_PORT=8001
JWT_ACCESS_TOKEN_MINUTES=120

# Local development placeholders. Replace them with separate random keys.
DJANGO_SECRET_KEY=marketflow-local-django-example
MOCK_PAYMENT_SECRET=marketflow-local-mock-payment-example

# Base URL for public product image links
PRODUCT_IMAGE_BASE_URL=https://cdn.example.com/media
